---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsCard from '../NewsCard.astro';
import ProjectRow from '../ProjectRow.astro';
import { t, localizePath } from '../../lib/i18n.js';
import { getLatestNews, getActiveProjects } from '../../lib/queries.js';

const { lang } = Astro.props;
const [news, projects] = await Promise.all([getLatestNews(2), getActiveProjects()]);

const title = lang === 'me' ? 'Naslovna' : 'Home';
const description =
  lang === 'me'
    ? 'NU Lea Bar — podrška ženama, djevojkama i porodicama u Baru.'
    : 'NU Lea Bar — support for women, girls and families in Bar, Montenegro.';
---

<BaseLayout lang={lang} title={title} description={description}>
  <div class="hero">
    <div class="wrap hero-grid">
      <div data-reveal>
        <div class="eyebrow">{lang === 'me' ? 'Bar, Crna Gora' : 'Bar, Montenegro'}</div>
        <h1>{lang === 'me' ? 'Podrška ženama, djevojkama i porodicama.' : 'Support for women, girls and families.'}</h1>
        <p class="lead">
          {lang === 'me'
            ? 'Radimo na prevenciji nasilja, osnaživanju djevojaka i podršci roditeljima. Sve naše usluge su besplatne, a sve što nam kažete ostaje povjerljivo.'
            : 'We work on violence prevention, empowering girls and supporting parents. All our services are free, and everything you tell us stays confidential.'}
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" href={localizePath('/kontakt/', lang)}>
            {lang === 'me' ? 'Treba mi podrška' : 'I need support'}
          </a>
          <a class="btn btn-ghost" href={localizePath('/projekti/', lang)}>
            {t(lang, 'nav_projects')}
          </a>
        </div>
      </div>
      <div class="stat-stack" data-reveal style="--reveal-delay:150ms">
        <div class="stat"><b>24/7</b><span>{lang === 'me' ? 'SOS linija, svakog dana u godini' : 'SOS line, every day of the year'}</span></div>
        <div class="stat"><b>0 &euro;</b><span>{lang === 'me' ? 'Sve usluge su besplatne' : 'All services are free of charge'}</span></div>
        <div class="stat"><b>{lang === 'me' ? 'Povjerljivo' : 'Confidential'}</b><span>{lang === 'me' ? 'Bez prijave i bez uslova' : 'No registration, no conditions'}</span></div>
      </div>
    </div>
    <div class="wrap">
      <!--
        Prostor za pravu fotografiju (npr. sa radionice), sa suptilnim
        Ken Burns zumom. Dok fajl ne postoji na /assets/hero.jpg, panel
        se tiho uklanja (onerror) — ne prikazuje se slomljena slika.
        Kad dodaš fotografiju, upiši i pravi opisni alt tekst ispod.
      -->
      <div class="hero-photo" data-reveal style="--reveal-delay:220ms">
        <img src="/assets/hero.jpg" alt="" loading="eager" onerror="this.closest('.hero-photo').remove()" />
      </div>
    </div>
  </div>

  <section class="sec">
    <div class="wrap">
      <div class="sec-head" data-reveal><h2>{t(lang, 'what_we_do')}</h2></div>
      <div class="prog-grid">
        <div class="prog" data-reveal>
          <h3>{lang === 'me' ? 'Podrška ženama i djeci' : 'Support for women and children'}</h3>
          <p>
            {lang === 'me'
              ? 'Savjetovanje, pratnja kroz institucije i povezivanje sa uslugama sigurnog smještaja.'
              : 'Counselling, accompaniment through institutions and referral to safe accommodation services.'}
          </p>
        </div>
        <div class="prog" data-reveal style="--reveal-delay:90ms">
          <h3>{lang === 'me' ? 'Osnaživanje djevojaka' : 'Empowering girls'}</h3>
          <p>
            {lang === 'me'
              ? 'Vršnjačka edukacija o rodnoj ravnopravnosti, prepoznavanju nasilja i pravima djevojaka.'
              : 'Peer education on gender equality, recognising violence and the rights of girls.'}
          </p>
        </div>
        <div class="prog" data-reveal style="--reveal-delay:180ms">
          <h3>{lang === 'me' ? 'Rad sa roditeljima' : 'Working with parents'}</h3>
          <p>
            {lang === 'me'
              ? 'Otvorena predavanja o prevenciji rizičnog ponašanja i podršci adolescentima.'
              : 'Open lectures on preventing risk behaviour and supporting adolescents.'}
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec sec-alt">
    <div class="wrap">
      <div class="sec-head" data-reveal>
        <h2>{t(lang, 'news_heading')}</h2>
        <a href={localizePath('/vijesti/', lang)}>{t(lang, 'all_news')}</a>
      </div>
      {news.length > 0 ? (
        <div class="news-grid">
          {news.map((item, i) => <NewsCard lang={lang} news={item} index={i} />)}
        </div>
      ) : (
        <p class="empty-note">{t(lang, 'no_news_yet')}</p>
      )}
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec-head" data-reveal>
        <h2>{t(lang, 'current_projects_heading')}</h2>
        <a href={localizePath('/projekti/', lang)}>{t(lang, 'all_projects')}</a>
      </div>
      {projects.length > 0 ? (
        <div class="proj-list">
          {projects.map((project, i) => <ProjectRow lang={lang} project={project} index={i} />)}
        </div>
      ) : (
        <p class="empty-note">{t(lang, 'no_projects_yet')}</p>
      )}
    </div>
  </section>
</BaseLayout>