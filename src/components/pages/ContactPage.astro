---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../lib/i18n.js';

const { lang } = Astro.props;
---

<BaseLayout lang={lang} title={t(lang, 'contact_page_title')} description={t(lang, 'contact_page_lead')}>
  <div class="contact-hero">
    <div class="wrap" data-reveal>
      <div class="eyebrow">{t(lang, 'contact_page_title')}</div>
      <h1 class="ab-display">{lang === 'me' ? 'Potraži podršku' : 'Seek support'}</h1>
      <p>{t(lang, 'contact_page_lead')}</p>
    </div>
  </div>

  <section class="contact-panel-sec">
    <div class="wrap">
      <div class="contact-panel" data-reveal>
        <h2>{lang === 'me' ? 'Podaci za kontakt' : 'Contact details'}</h2>
        <p class="contact-panel-intro">
          {lang === 'me'
            ? 'Tu smo za vas — kontaktirajte nas na način koji vam najviše odgovara.'
            : 'We are here for you — reach out in whichever way suits you best.'}
        </p>

        <div class="contact-tiles">
          <a class="contact-tile" href="tel:+38268692231">
            <span class="contact-tile-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </span>
            <span class="contact-tile-label">{lang === 'me' ? 'Telefon' : 'Phone'}</span>
            <span class="contact-tile-value">068/692-231</span>
          </a>
          <a class="contact-tile" href="mailto:skloniste.leabar@gmail.com">
            <span class="contact-tile-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
            </span>
            <span class="contact-tile-label">{lang === 'me' ? 'E-pošta' : 'Email'}</span>
            <span class="contact-tile-value">skloniste.leabar@gmail.com</span>
          </a>
          <a
            class="contact-tile"
            href="https://www.facebook.com/profile.php?id=61573582000626"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="contact-tile-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21v-7.5h2.51l.5-3h-3.01V8.41c0-.87.25-1.46 1.5-1.46h1.6V4.28c-.28-.04-1.22-.13-2.32-.13-2.3 0-3.87 1.4-3.87 3.98v2.37H8v3h2.41V21h3.09z"/></svg>
            </span>
            <span class="contact-tile-label">Facebook</span>
            <span class="contact-tile-value">NU Lea Bar</span>
          </a>
          <a
            class="contact-tile"
            href="https://www.instagram.com/nu.leabar"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="contact-tile-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4.2" /><circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none" /></svg>
            </span>
            <span class="contact-tile-label">Instagram</span>
            <span class="contact-tile-value">@nu.leabar</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
