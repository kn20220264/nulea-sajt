---
import { categoryLabel, localizePath, t } from '../lib/i18n.js';
import { urlFor } from '../lib/sanity.js';
import mapSvg from '../assets/montenegro-outline.svg?raw';

const { lang, news = [] } = Astro.props;

const slides = news.map((item) => {
  const alt = (lang === 'me' ? item.coverImage?.altMe : item.coverImage?.altEn) || item.coverImage?.alt || '';
  const imgUrl = item.coverImage?.asset
    ? urlFor(item.coverImage).width(1200).height(1400).fit('crop').auto('format').url()
    : null;
  return {
    href: localizePath(`/vijesti/${item.slug}/`, lang),
    category: categoryLabel(lang, item.category),
    title: item.title?.[lang] ?? '',
    excerpt: item.excerpt?.[lang] ?? '',
    imgUrl,
    alt,
  };
});

const showControls = slides.length > 1;
const pad = (n) => String(n + 1).padStart(2, '0');
---

{slides.length > 0 && (
  <section class="feat-carousel">
    <div class="wrap feat-grid">
      <div class="feat-visual">
        <div class="feat-map" aria-hidden="true" set:html={mapSvg} />
        <div class="feat-slides">
          {slides.map((s, i) => (
            <div class="feat-slide-img" data-slide-img data-index={i} hidden={i !== 0}>
              <a href={s.href} tabindex={i === 0 ? undefined : -1}>
                {s.imgUrl && <img class="feat-triangle" src={s.imgUrl} alt={s.alt} loading={i === 0 ? 'eager' : 'lazy'} width="1200" height="1400" />}
              </a>
            </div>
          ))}
        </div>
      </div>

      <div class="feat-text">
        <div aria-live="polite">
          {slides.map((s, i) => (
            <div class="feat-slide-text" data-slide-text data-index={i} hidden={i !== 0}>
              <div class="eyebrow">{s.category}</div>
              <h3><a href={s.href}>{s.title}</a></h3>
              <p>{s.excerpt}</p>
            </div>
          ))}
        </div>

        {showControls && (
          <div class="feat-controls" data-carousel-controls>
            <button type="button" class="feat-arrow feat-arrow-prev" data-prev aria-label={t(lang, 'prev_news')}>
              <svg class="feat-arrow-shape" width="52" height="44" viewBox="0 0 52 44" aria-hidden="true">
                <polygon points="50,2 50,42 2,22" fill="none" stroke="var(--c-ink)" stroke-width="1.5" stroke-linejoin="round" />
                <path d="M31 15 L22 22 L31 29" fill="none" stroke="var(--c-ink)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
            <button type="button" class="feat-arrow feat-arrow-next" data-next aria-label={t(lang, 'next_news')}>
              <svg class="feat-arrow-shape" width="52" height="44" viewBox="0 0 52 44" aria-hidden="true">
                <polygon points="2,2 2,42 50,22" fill="var(--c-ink)" />
                <path d="M18 15 L27 22 L18 29" fill="none" stroke="var(--c-paper)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
            <span class="feat-index" data-index-label aria-hidden="true">{pad(0)} / {pad(slides.length - 1)}</span>
          </div>
        )}
      </div>
    </div>
  </section>
)}

<script>
  document.querySelectorAll('[data-carousel-controls]').forEach((controls) => {
    const section = controls.closest('.feat-carousel');
    if (!section) return;

    const imgs = Array.from(section.querySelectorAll('[data-slide-img]'));
    const texts = Array.from(section.querySelectorAll('[data-slide-text]'));
    const indexLabel = controls.querySelector('[data-index-label]');
    const count = imgs.length;
    let active = 0;

    const pad = (n) => String(n + 1).padStart(2, '0');

    function show(next) {
      if (next === active) return;
      const prevImg = imgs[active];
      const prevText = texts[active];
      const nextImg = imgs[next];
      const nextText = texts[next];

      prevImg.hidden = true;
      prevText.hidden = true;
      nextImg.hidden = false;
      nextText.hidden = false;

      const nextImgLink = nextImg.querySelector('a');
      if (nextImgLink) nextImgLink.removeAttribute('tabindex');
      const prevImgLink = prevImg.querySelector('a');
      if (prevImgLink) prevImgLink.setAttribute('tabindex', '-1');

      [nextImg, nextText].forEach((el) => {
        el.classList.remove('is-entering');
        // force reflow so the animation restarts every time
        void el.offsetWidth;
        el.classList.add('is-entering');
      });

      if (indexLabel) indexLabel.textContent = `${pad(next)} / ${pad(count - 1)}`;
      active = next;
    }

    controls.querySelector('[data-prev]')?.addEventListener('click', () => {
      show((active - 1 + count) % count);
    });
    controls.querySelector('[data-next]')?.addEventListener('click', () => {
      show((active + 1) % count);
    });
  });
</script>
