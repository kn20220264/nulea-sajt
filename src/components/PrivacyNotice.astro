---
import { t } from '../lib/i18n.js';
const { lang } = Astro.props;
---

<div class="privacy">
  <div class="wrap">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#E81C65" stroke-width="2" aria-hidden="true">
      <path d="M12 2 4 6v6c0 5 3.4 9.2 8 10 4.6-.8 8-5 8-10V6l-8-4z"></path>
    </svg>
    <span>{t(lang, 'privacy_notice')}</span>
  </div>
</div>