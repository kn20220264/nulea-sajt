---
import { t, localizePath } from '../lib/i18n.js';

const { lang } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-foot">
  <div class="wrap">
    <hr class="foot-rule" />

    <div class="foot-top">
      <div class="foot-grid">
        <div class="foot-col">
          <div class="foot-brand">NU Lea Bar</div>
        </div>
        <div class="foot-col">
          <h4>{t(lang, 'footer_contact_heading')}</h4>
          <a href="tel:+38268692231">068/692-231</a>
          <a href="mailto:skloniste.leabar@gmail.com">skloniste.leabar@gmail.com</a>
          <p class="foot-address">Brbot bb, Bar</p>
        </div>
        <div class="foot-col">
          <h4>{t(lang, 'footer_org_heading')}</h4>
          <a href={localizePath('/o-nama/', lang)}>{t(lang, 'nav_about')}</a>
          <a href={localizePath('/projekti/', lang)}>{t(lang, 'nav_projects')}</a>
          <a href={localizePath('/vijesti/', lang)}>{t(lang, 'nav_news')}</a>
        </div>
        <div class="foot-col">
          <h4>{t(lang, 'footer_donations_heading')}</h4>
          <p class="foot-donation-label">{t(lang, 'donation_account_label')}</p>
          <p class="foot-account">Lovćen banka: 565-7196-33</p>
        </div>
      </div>

      <div class="foot-cta">
        <a class="btn-donate" href={localizePath('/doniraj/', lang)}>
          {lang === 'me' ? 'Doniraj' : 'Donate'} <span aria-hidden="true">→</span>
        </a>
        <div class="foot-social">
          <a
            class="social-icon"
            href="https://www.facebook.com/profile.php?id=61573582000626"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M13.5 21v-7.5h2.51l.5-3h-3.01V8.41c0-.87.25-1.46 1.5-1.46h1.6V4.28c-.28-.04-1.22-.13-2.32-.13-2.3 0-3.87 1.4-3.87 3.98v2.37H8v3h2.41V21h3.09z"/>
            </svg>
          </a>
          <a
            class="social-icon"
            href="https://www.instagram.com/nu.leabar"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4.2" />
              <circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none" />
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div class="foot-bottom">
      <span>&copy; {year} NU Lea Bar</span>
      <span>
        {t(lang, 'made_by_prefix')} ♥ {t(lang, 'made_by_suffix')}{' '}
        <a href="https://be-bold.me" target="_blank" rel="noopener noreferrer">BeBold</a>
      </span>
    </div>
  </div>
</footer>
