---
import { t } from '../lib/i18n.js';

const { lang, sosNumber, sosNote } = Astro.props;
const telHref = `tel:${sosNumber.replace(/\s+/g, '')}`;
---

<section class="safety-band">
  <div class="wrap">
    <hr class="foot-rule" />
    <div class="safety-band-inner">
      <p class="safety-band-line">
        <strong>{t(lang, 'safety_band_heading')}</strong>
        <span class="sos-label">{t(lang, 'sos_label')}</span>
        <a class="sos-num" href={telHref}>{sosNumber}</a>
        {sosNote && <span class="sos-note">{sosNote}</span>}
      </p>
      <p class="safety-band-privacy">{t(lang, 'privacy_notice')}</p>
    </div>
  </div>
</section>
